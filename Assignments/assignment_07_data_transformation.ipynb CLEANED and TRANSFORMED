        "## 2. Check for Skew in a Numeric Column\n",
        "\n",
        "### Business framing:  \n",
        "\n",
        "Airbnb listings can have a wide range of values for things like price, availability, or reviews. These kinds of distributions can be hard to visualize, summarize, or model.\n",
        "\n",
        "### Do the following:\n",
        "Choose one **numeric column** that appears skewed and do the following:\n",
        "- Plot a histogram\n",
        "- Apply a transformation (e.g., log or other method)\n",
        "- Plot again to compare"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Ensure we clean the Airbnb 'price' column (remove '$' and commas, convert to numeric)\n",
        "if 'price' in df.columns:\n",
        "    df['price_clean'] = df['price'].astype(str).str.replace('$', '').str.replace(',', '').astype(float)\n",
        "    clean_series = df['price_clean'].dropna()\n",
        "\n",
        "    # Create a figure with two subplots\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
        "\n",
        "    # 1. Plot original distribution\n",
        "    sns.histplot(clean_series, kde=True, ax=axes[0], color='skyblue')\n",
        "    axes[0].set_title(f'Original Airbnb Price (Skew: {clean_series.skew():.2f})')\n",
        "    axes[0].set_xlabel('Price ($)')\n",
        "\n",
        "    # 2. Apply Log Transformation\n",
        "    df['transformed_price'] = np.log1p(clean_series)\n",
        "\n",
        "    # 3. Plot transformed distribution\n",
        "    sns.histplot(df['transformed_price'].dropna(), kde=True, ax=axes[1], color='salmon')\n",
        "    axes[1].set_title(f'Log Transformed Price (Skew: {df[\"transformed_price\"].skew():.2f})')\n",
        "    axes[1].set_xlabel('log(Price + 1)')\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "else:\n",
        "    print(\"Could not find 'price' column in the loaded Airbnb dataset.\")"
      ],
